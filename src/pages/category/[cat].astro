---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES, getCategory } from '../../data/categories';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { cat: c.slug } }));
}

const { cat } = Astro.params as { cat: string };
const allArticles = await getCollection('articles');

const articles = allArticles
  .filter((a: CollectionEntry<'articles'>) => a.data.category === cat && a.data.draft !== true)
  .sort((a: CollectionEntry<'articles'>, b: CollectionEntry<'articles'>) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

const typeLabel: Record<string, string> = {
  analysis: 'Analysis',
  news: 'News',
  'deep-dive': 'Deep Dive'
};

const c = getCategory(cat)!;
const meta = { title: c.title, icon: c.icon, desc: c.desc };
---

<BaseLayout title={meta.title} description={meta.desc}>

<div class="cat-page">

  <div class="cat-header">
    <div class="cat-header-inner">
      <div class="cat-eyebrow">Category</div>
      <h1 class="cat-title">
        <span class="cat-icon" set:html={meta.icon}></span>
        {meta.title}
      </h1>
      <p class="cat-desc">{meta.desc}</p>
      <div class="cat-count">{articles.length} {articles.length === 1 ? 'article' : 'articles'}</div>
    </div>
  </div>

  <div class="cat-nav">
    <div class="cat-nav-inner">
      {CATEGORIES.map((c) => (
        <a href={`/category/${c.slug}/`} class={cat === c.slug ? 'cat-nav-btn active' : 'cat-nav-btn'}>{c.label}</a>
      ))}
    </div>
  </div>

  <div class="cat-articles">
    {articles.length === 0 && (
      <div class="cat-empty">
        <div class="cat-empty-icon">📭</div>
        <div class="cat-empty-t">No articles yet</div>
        <div class="cat-empty-d">Check back soon.</div>
      </div>
    )}
    {articles.length > 0 && articles.map((article: CollectionEntry<'articles'>, i: number) => (
        <a href={`/articles/${article.id}`} class="cat-row">
          <div class="cat-row-n">{String(i + 1).padStart(2, '0')}</div>
          <div class="cat-row-body">
            <div class="cat-row-meta">
              <span class="cat-row-type">{typeLabel[article.data.type] ?? article.data.type}</span>
              <span class="cat-row-date">
                {new Date(article.data.date).toLocaleDateString('en-US', {
                  month: 'short', day: 'numeric', year: 'numeric'
                })}
              </span>
            </div>
            <h2 class="cat-row-h">{article.data.title}</h2>
            <p class="cat-row-dek">{article.data.description}</p>
            <div class="cat-row-foot">
              <span class="cat-row-author">{article.data.author}</span>
              <span class="cat-row-rt">{article.data.readTime} min read</span>
            </div>
          </div>
          <div class="cat-row-arrow">→</div>
        </a>
      
    ))}
  </div>

</div>

</BaseLayout>

<style>
.cat-header {
  background: var(--bg2);
  border-bottom: 1px solid var(--b);
  padding: 48px 0 40px;
}
.cat-header-inner {
  max-width: 1220px;
  margin: 0 auto;
  padding: 0 32px;
}
.cat-eyebrow {
  font-family: 'Space Mono', monospace;
  font-size: 9px; letter-spacing: .14em; text-transform: uppercase;
  color: var(--amber); margin-bottom: 16px;
}
.cat-title {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(40px, 6vw, 72px);
  line-height: .95; letter-spacing: .02em; color: var(--paper);
  margin-bottom: 14px; display: flex; align-items: center; gap: 16px;
}
.cat-icon { font-size: 48px; line-height: 1; }
.cat-desc {
  font-family: 'Libre Baskerville', serif;
  font-size: 15px; font-style: italic;
  color: rgba(245,240,232,.45); margin-bottom: 16px;
}
.cat-count {
  font-family: 'Space Mono', monospace;
  font-size: 10px; letter-spacing: .1em; text-transform: uppercase;
  color: rgba(245,240,232,.25);
}
.cat-nav {
  border-bottom: 1px solid var(--b);
  background: var(--bg2);
}
.cat-nav-inner {
  max-width: 1220px;
  margin: 0 auto;
  padding: 0 32px;
  display: flex;
  gap: 0;
  overflow-x: auto;
}
.cat-nav-btn {
  font-family: 'Space Mono', monospace;
  font-size: 10px; letter-spacing: .1em; text-transform: uppercase;
  color: rgba(245,240,232,.35); padding: 14px 18px;
  border-bottom: 2px solid transparent;
  transition: all .18s; white-space: nowrap;
}
.cat-nav-btn:hover { color: var(--paper); }
.cat-nav-btn.active { color: var(--amber); border-bottom-color: var(--amber); }
.cat-articles { max-width: 1220px; margin: 0 auto; padding: 0 32px; }
.cat-row {
  display: flex; align-items: flex-start; gap: 24px;
  padding: 28px 0; border-bottom: 1px solid var(--b);
  transition: background .18s; text-decoration: none; color: inherit;
}
.cat-row:hover {
  background: var(--dim2);
  margin: 0 -32px; padding: 28px 32px;
}
.cat-row:hover .cat-row-h { color: var(--amber); }
.cat-row-n {
  font-family: 'Space Mono', monospace;
  font-size: 10px; color: var(--amber);
  padding-top: 4px; min-width: 28px; flex-shrink: 0;
}
.cat-row-body { flex: 1; max-width: 720px; }
.cat-row-meta { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
.cat-row-type {
  font-family: 'Space Mono', monospace;
  font-size: 8px; letter-spacing: .1em; text-transform: uppercase;
  background: var(--amber); color: var(--ink); padding: 2px 7px;
}
.cat-row-date {
  font-family: 'Space Mono', monospace;
  font-size: 9px; color: rgba(245,240,232,.3); letter-spacing: .06em;
}
.cat-row-h {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 26px; line-height: 1.05; letter-spacing: .02em;
  color: var(--paper); margin-bottom: 8px; transition: color .18s;
}
.cat-row-dek {
  font-family: 'Libre Baskerville', serif;
  font-size: 13.5px; font-style: italic;
  color: rgba(245,240,232,.4); line-height: 1.6;
  margin-bottom: 12px; max-width: 600px;
}
.cat-row-foot { display: flex; align-items: center; gap: 16px; }
.cat-row-author {
  font-family: 'Space Mono', monospace;
  font-size: 9px; color: rgba(245,240,232,.3); letter-spacing: .06em;
}
.cat-row-rt {
  font-family: 'Space Mono', monospace;
  font-size: 9px; color: rgba(245,240,232,.2);
}
.cat-row-arrow {
  font-family: 'Space Mono', monospace;
  font-size: 14px; color: rgba(245,240,232,.2);
  padding-top: 4px; flex-shrink: 0;
  transition: color .18s, transform .18s;
}
.cat-row:hover .cat-row-arrow { color: var(--amber); transform: translateX(4px); }
.cat-empty { text-align: center; padding: 80px 20px; }
.cat-empty-icon { font-size: 48px; margin-bottom: 16px; opacity: .4; }
.cat-empty-t {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 28px; color: rgba(245,240,232,.3); margin-bottom: 8px;
}
.cat-empty-d {
  font-family: 'Space Mono', monospace;
  font-size: 10px; color: rgba(245,240,232,.2); letter-spacing: .08em;
}
@media (max-width: 768px) {
  .cat-header-inner, .cat-articles { padding: 0 18px; }
  .cat-nav-inner { padding: 0 18px; }
  .cat-row:hover { margin: 0 -18px; padding: 28px 18px; }
  .cat-title { font-size: 36px; }
}
</style>