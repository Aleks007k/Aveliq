---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EDITORIAL, EDITORIAL_PATH } from '../data/editorial';
---

<BaseLayout title="About" description="Aveliq compares software for freelancers and small teams: invoicing and payments, email and marketing, scheduling and forms, sales tools, and AI tools for everyday work.">
  <section class="about">

    <div class="about-hero">
      <div class="about-eyebrow">About</div>
      <h1 class="about-h1">About Aveliq</h1>
    </div>

    <div class="about-body">

      <div class="about-block">
        <div class="about-block-label">What we do</div>
        <div class="about-block-content">
          <p>Aveliq compares software for freelancers and small teams: invoicing and payments, email and marketing, scheduling and forms, sales tools, and AI tools for everyday work.</p>
          <p>We focus on the question most comparison pages skip: what a tool will actually cost you. Every comparison shows the price at a realistic team size, where the free plan stops, and which plan you need for the job — not just the starting price.</p>
        </div>
      </div>

      <div class="about-block">
        <div class="about-block-label">How we work</div>
        <div class="about-block-content">
          <p>Prices and plan limits come from each vendor's own pricing page, and every article shows the date we checked. Where a pricing page is unclear, we cross-check against independent pricing reviews and say so. We have not tested a product hands-on unless the article says we did. Prices change: if you spot an outdated number, email us and we'll fix it and update the date.</p>
        </div>
      </div>

      <div class="about-block">
        <div class="about-block-label">How AI is used</div>
        <div class="about-block-content">
          <p>Aveliq is a small, AI-assisted publication. AI tools help us gather pricing data, draft articles and check them for errors. Articles are published under <a href={EDITORIAL_PATH}>"{EDITORIAL.name}"</a>, a shared editorial byline — not a real person. Every article is approved for publication by the site's owner.</p>
        </div>
      </div>

      <div class="about-block">
        <div class="about-block-label">How we make money</div>
        <div class="about-block-content">
          <p>Some links on Aveliq are affiliate links, marked with *. If you buy through one, we may earn a commission at no extra cost to you. It doesn't change our verdicts: we compare tools whether or not they have an affiliate program, and we say so when a cheaper or free option is the better choice.</p>
        </div>
      </div>

      <div class="about-block">
        <div class="about-block-label">Contact</div>
        <div class="about-block-content">
          <p><a href="mailto:editorial@aveliq.net">editorial@aveliq.net</a> · <a href="/privacy/">Privacy</a> · <a href="/affiliate-disclosure/">Affiliate disclosure</a></p>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
.about-hero {
  background: var(--bg2);
  border-bottom: 1px solid var(--b);
  padding: 60px 40px 48px;
}
.about-eyebrow {
  font-family: 'Space Mono', monospace;
  font-size: 9px;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--amber);
  margin-bottom: 16px;
}
.about-h1 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: clamp(48px, 7vw, 88px);
  line-height: .95;
  letter-spacing: .02em;
  color: var(--paper);
}
.about-body {
  max-width: 800px;
  margin: 0 auto;
  padding: 0 40px 80px;
}
.about-block {
  display: grid;
  grid-template-columns: 180px 1fr;
  gap: 40px;
  padding: 48px 0;
  border-bottom: 1px solid var(--b);
}
.about-block-label {
  font-family: 'Space Mono', monospace;
  font-size: 9px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--amber);
  padding-top: 4px;
}
.about-block-content p {
  font-family: 'Libre Baskerville', serif;
  font-size: 16px;
  color: rgba(245,240,232,.7);
  line-height: 1.8;
  margin-bottom: 16px;
}
.about-block-content p:last-child { margin-bottom: 0; }
.about-block-content a { color: var(--amber); border-bottom: 1px solid rgba(212,168,83,.3); }
.about-block-content a:hover { border-color: var(--amber); }

.author-entry { margin-top: 28px; }
.author-entry:first-child { margin-top: 0; }

.author-card {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 12px;
  padding: 20px;
  background: var(--bg2);
  border: 1px solid var(--b);
}
.author-av {
  width: 44px;
  height: 44px;
  background: var(--amber);
  color: var(--ink);
  display: grid;
  place-items: center;
  font-family: 'Space Mono', monospace;
  font-size: 13px;
  font-weight: 700;
  flex-shrink: 0;
}
.author-name-link { text-decoration: none; }
.author-name-link:hover .author-name { color: var(--amber); }
.author-name {
  font-family: 'Space Mono', monospace;
  font-size: 12px;
  font-weight: 700;
  color: var(--paper);
  margin-bottom: 4px;
  transition: color .18s;
}
.author-role {
  font-family: 'Space Mono', monospace;
  font-size: 9px;
  color: rgba(245,240,232,.35);
  letter-spacing: .06em;
}
.author-desc {
  font-family: 'Libre Baskerville', serif;
  font-size: 16px;
  color: rgba(245,240,232,.7);
  line-height: 1.8;
}

@media (max-width: 768px) {
  .about-hero { padding: 40px 20px 32px; }
  .about-body { padding: 0 20px 60px; }
  .about-block { grid-template-columns: 1fr; gap: 16px; }
}
</style>